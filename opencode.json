{
  "mcp": {
    "servers": {
      "gimp": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--directory",
          "{env:INFINITEOC_HOME}/.tools/gimp-mcp",
          "gimp_mcp_server.py"
        ]
      },
      "Roblox_Studio": {
        "type": "local",
        "command": [
          "{env:INFINITEOC_HOME}/.tools/roblox-mcp/roblox-mcp.sh"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}